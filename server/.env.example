# Copy to .env and fill in. Never commit .env.
PAYPAL_CLIENT_ID=YOUR_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_CLIENT_SECRET
# QA host: set to the API base for your QA environment (confirm from the QA docs).
PAYPAL_API_BASE=https://api-m.qa.paypal.com
# JS SDK script host (QA may differ from https://www.paypal.com)
PAYPAL_JS_SDK_BASE=https://www.qa.paypal.com
CURRENCY=USD
PORT=3099
